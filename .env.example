# Copy to .env (never commit .env). Placeholder values only.
APEX_HOME=/path/to/apex-tennis

# Discord bot (discord_bot.py)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_BBALL_CLIENT_ID=0

# Discord channel webhooks used by openclaw_core.py
DISCORD_WEBHOOK_PICKS=https://discord.com/api/webhooks/000/placeholder
DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/000/placeholder
DISCORD_WEBHOOK_GENERAL=https://discord.com/api/webhooks/000/placeholder
DISCORD_WEBHOOK_LEARNING=https://discord.com/api/webhooks/000/placeholder
DISCORD_WEBHOOK_SYSTEM=https://discord.com/api/webhooks/000/placeholder
DISCORD_WEBHOOK_MONEYLINE=https://discord.com/api/webhooks/000/placeholder

# Claude API (optional AI summaries)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Mission Control dashboard basic auth (openclaw_mission_control.py)
MC_AUTH_USER=admin
MC_AUTH_PASS=change-me

# Optional switches
APEX_DEBUG=0
APEX_NO_ALERTS=0
APEX_ENGINE_ONLY=0

# --- File-based keys -------------------------------------------------
# Some data-provider keys are read from one-line text files in the repo
# root (all ignored by .gitignore). Create them yourself:
#   sportapi365_key.txt      SportsAPI365 (RapidAPI) key
#   oddspapi_key.txt         OddsPapi key
#   sportsgameodds_key.txt   SportsGameOdds key
#   anthropic_key.txt        optional, overrides ANTHROPIC_API_KEY
#   apex_alis_webhook.txt    optional webhook URL for the #alis channel
# ParlayPlay webhooks live in ApexParlayPlay/data/config.json, see
# ApexParlayPlay/config.example.json.
