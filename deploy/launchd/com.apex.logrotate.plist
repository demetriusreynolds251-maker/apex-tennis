<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.apex.logrotate</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>/path/to/home/openclaw/tools/rotate_logs.py</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/path/to/home/openclaw/data/logs/logrotate.log</string>
  <key>StandardErrorPath</key><string>/path/to/home/openclaw/data/logs/logrotate.log</string>
</dict>
</plist>
