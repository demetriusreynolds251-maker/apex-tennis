<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DISCORD_BOT_TOKEN</key>
		<string>REPLACE_WITH_DISCORD_BOT_TOKEN</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.apex.discordbot</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/path/to/home/openclaw/discord_bot.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/path/to/home/openclaw/data/logs/discord_bot_error.log</string>
	<key>StandardOutPath</key>
	<string>/path/to/home/openclaw/data/logs/discord_bot.log</string>
	<key>WorkingDirectory</key>
	<string>/path/to/home/openclaw</string>
</dict>
</plist>
