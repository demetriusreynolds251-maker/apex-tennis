<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.apex.apexscheduler</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-c</string>
		<string>import subprocess,sys; sys.exit(subprocess.call(['/bin/zsh','/path/to/home/openclaw_jobs/apex_scheduler.sh']))</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/path/to/home/openclaw_jobs/apex_scheduler_launchd.log</string>
	<key>StandardOutPath</key>
	<string>/path/to/home/openclaw_jobs/apex_scheduler_launchd.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>/path/to/home/openclaw_jobs</string>
</dict>
</plist>
