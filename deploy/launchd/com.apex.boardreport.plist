<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apex.boardreport</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-c</string>
		<string>import subprocess,sys; sys.exit(subprocess.call(['/bin/zsh','/path/to/home/openclaw_jobs/apex_board_report.sh']))</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/path/to/home/openclaw_jobs/boardreport_launchd.log</string>
	<key>StandardOutPath</key>
	<string>/path/to/home/openclaw_jobs/boardreport_launchd.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/path/to/home/openclaw_jobs</string>
</dict>
</plist>
